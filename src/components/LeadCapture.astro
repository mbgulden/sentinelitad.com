---
interface CTA { label: string; href: string; variant?: "primary" | "secondary" }
interface Props { eyebrow: string; title: string; body: string; ctas?: CTA[]; form?: boolean }
const { eyebrow, title, body, ctas = [], form = false } = Astro.props;
---
<section id="contact" class="section contact" data-emdash-block="lead-capture">
  <div class="contact-copy"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{body}</p></div>
  {form ? <form class="lead-form" action="https://formsubmit.co/team@sentinelitad.com" method="POST"><input type="hidden" name="_captcha" value="false" /><input type="hidden" name="_subject" value="Sentinel ITAD pickup request" /><label>Name<input name="name" required autocomplete="name" /></label><label>Company<input name="company" required autocomplete="organization" /></label><label>Email<input name="email" type="email" required autocomplete="email" /></label><label>Phone<input name="phone" type="tel" autocomplete="tel" /></label><label>Project details<textarea name="message" rows="5"></textarea></label><button class="button primary" type="submit">Send request</button></form> : <div class="lead-form">{ctas.map((cta) => <a class={`button ${cta.variant ?? "primary"}`} href={cta.href}>{cta.label}</a>)}</div>}
</section>
